# =============================================================
# JCI 専務理事AIエージェント 環境変数テンプレート
# 手元で動かすときは .env にコピーして実値を書く（.env は git に入れないこと）
# 各項目の説明は docs/configuration.md を参照
# =============================================================

# --- 基本 ---
GCP_PROJECT_ID=
TZ=Asia/Tokyo
# admin にすると管理サービスとして動く（IAP の後ろでだけ設定する）
ROLE=
# 公開サービスの URL（LINE で送るリンクに使う）
PUBLIC_BASE_URL=

# --- シークレット（本番は Secret Manager。環境変数があればそちらを優先）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ADMIN_API_SECRET=
# 対外連絡メールの取込（LOM 公式 Gmail の OAuth。scripts/gmail_oauth_setup.py で取得）
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# --- LOM の情報（公開・管理の両サービスに同じ値。docs/configuration.md「LOM の情報」）---
LOM_ID=
LOM_NAME=
LOM_SHORT_NAME=
BOT_NAME=
LINE_BASIC_ID=
ADMIN_BASE_URL=
LOM_GOOGLE_ACCOUNT=

# --- AI（Vertex AI）---
VERTEX_AI_LOCATION=asia-northeast1
# タスク別のモデル表（app/llm.py の TASK_MODELS）に無いタスクで使うモデル
GEMINI_MODEL=gemini-2.5-pro
# 管理画面の「当月コスト」の概算（任意。USD / 100万トークン、固定費は USD / 月）
LLM_PRICE_INPUT_USD_PER_1M=
LLM_PRICE_OUTPUT_USD_PER_1M=
INFRA_MONTHLY_USD=

# --- LINE（LIFF）---
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# 1 で返信を Webhook の外で作る（scripts/setup_line_reply.sh の後）
LINE_ASYNC_REPLY=

# --- データレイク・検索（scripts/setup_datalake.sh / setup_lake_ai.sh）---
LINE_EVENTS_TOPIC=
LINE_CONTENT_BUCKET=
LINE_CONTENT_MAX_BYTES=
PUBSUB_PUSH_SA=
PUBSUB_PUSH_AUDIENCE=
LAKE_DATASET=line_lake
LAKE_LOCATION=asia-northeast1
LAKE_EMBEDDING_MODEL=

# --- Google Workspace ---
GCAL_CALENDAR_ID=
# 検索の対象にするドライブのフォルダ ID（カンマ区切り）
DRIVE_KNOWLEDGE_FOLDERS=
# ドライブ取込で除外する語を足す（カンマ区切り。既定の「名簿」などに加える）
DRIVE_EXCLUDE_WORDS=
COMMITTEE_DOCS_FOLDER=
PLAN_TEMPLATE_DOC=
# 未指定は「対外連絡」
GMAIL_LABEL=

# --- 議事録（scripts/setup_minutes.sh が設定）---
MINUTES_BUCKET=
MINUTES_TOPIC=
